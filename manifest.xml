<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Quick Sheet - Excel add-in manifest.
  Before uploading: replace every  YOUR-GITHUB-USERNAME  with your GitHub user name (Notepad: Ctrl+H, Replace All).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>2df0b978-0313-4858-9087-ba15bec56334</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Mantis Networks (Pty) Ltd</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Quick Sheet"/>
  <Description DefaultValue="Add a new, uniquely named worksheet to your workbook in one click."/>
  <IconUrl DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/support.html"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="Support.Url"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="QuickSheet.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="QuickSheet.NewSheet">
                  <Label resid="NewSheet.Label"/>
                  <Supertip>
                    <Title resid="NewSheet.Label"/>
                    <Description resid="NewSheet.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>createSheetFromRibbon</FunctionName>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="QuickSheet.Pane">
                  <Label resid="Pane.Label"/>
                  <Supertip>
                    <Title resid="Pane.Label"/>
                    <Description resid="Pane.Tip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>QuickSheetPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/taskpane.html"/>
        <bt:Url id="Support.Url" DefaultValue="https://YOUR-GITHUB-USERNAME.github.io/quicksheet/support.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Quick Sheet is ready"/>
        <bt:String id="Group.Label" DefaultValue="Quick Sheet"/>
        <bt:String id="NewSheet.Label" DefaultValue="New Sheet"/>
        <bt:String id="Pane.Label" DefaultValue="Named Sheet"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="On the Home tab, click New Sheet to add a sheet, or Named Sheet to choose its name."/>
        <bt:String id="NewSheet.Tip" DefaultValue="Adds a new sheet called New Sheet (numbered if the name is taken)."/>
        <bt:String id="Pane.Tip" DefaultValue="Opens a pane where you type a name for the new sheet."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
